# ---------------------------------------------------------------------------
# KeywordForge environment
# Copy to `.env` and fill in. Everything except DATABASE_URL is optional —
# with no provider credentials the app runs on the deterministic mock driver.
# ---------------------------------------------------------------------------

# Dev uses SQLite. For production swap to Postgres and change the datasource
# provider in prisma/schema.prisma to "postgresql":
#   DATABASE_URL="postgresql://user:pass@localhost:5432/keywordforge"
DATABASE_URL="file:./dev.db"

# Which keyword-data provider to use: "mock" | "dataforseo"
# Defaults to "mock" when unset, or when dataforseo credentials are missing.
KEYWORD_PROVIDER="mock"

# DataForSEO credentials (https://app.dataforseo.com/api-access)
# Only read when KEYWORD_PROVIDER=dataforseo.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
DATAFORSEO_BASE_URL="https://api.dataforseo.com"

# How long a cached upstream response is considered fresh, in days.
# PRD §12: re-querying the same keyword is the fastest way to burn budget.
PROVIDER_CACHE_TTL_DAYS="30"

# Claude API — optional. Powers AI-refined intent classification and content
# briefs. Without it the app falls back to the built-in heuristic classifier,
# which is deterministic and free.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
