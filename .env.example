# ---------------------------------------------------------------------------
# KeywordForge environment
# Copy to `.env` and fill in. Everything except DATABASE_URL is optional —
# with no provider credentials the app runs on the deterministic mock driver.
# ---------------------------------------------------------------------------

# Dev uses SQLite. For production swap to Postgres and change the datasource
# provider in prisma/schema.prisma to "postgresql":
#   DATABASE_URL="postgresql://user:pass@localhost:5432/keywordforge"
DATABASE_URL="file:./dev.db"

# Which keyword-data provider to use: "mock" | "dataforseo"
# Defaults to "mock" when unset, or when dataforseo credentials are missing.
KEYWORD_PROVIDER="mock"

# DataForSEO credentials (https://app.dataforseo.com/api-access)
# Only read when KEYWORD_PROVIDER=dataforseo.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
DATAFORSEO_BASE_URL="https://api.dataforseo.com"

# How long a cached upstream response is considered fresh, in days.
# PRD §12: re-querying the same keyword is the fastest way to burn budget.
PROVIDER_CACHE_TTL_DAYS="30"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# There is NO session signing secret to configure. Sessions are opaque random
# tokens stored server-side (hashed) rather than signed cookies, so there is no
# key to leak, rotate, or accidentally commit. See src/lib/auth/session.ts.
#
# DEV ONLY — bypasses the login form by resolving a named seeded user.
#
# MUST STAY EMPTY outside local development. A non-empty value here means
# anyone reaching the app is silently signed in as that user, with full access
# to their agency's data and no credentials required.
#
# This template ships it EMPTY on purpose so a copied .env is safe by default.
# The code refuses to honour it when NODE_ENV=production (see devAutoLogin in
# src/lib/tenancy.ts), but do not rely on that alone — set it only on a
# machine where you are the only user.
DEV_AUTO_LOGIN_EMAIL=""

# Test-only bcrypt cost override. Honoured ONLY when NODE_ENV=test; production
# is pinned at cost 12 regardless. Leave unset.
# BCRYPT_COST=""

# Claude API — optional. Powers AI-refined intent classification and content
# briefs. Without it the app falls back to the built-in heuristic classifier,
# which is deterministic and free.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
